# Anisa Herbal — environment variables
# Copy to .env.local and fill in. Everything here is optional: with no values
# set the site runs fine, it just does not track or persist orders anywhere.

# --- Order intake -----------------------------------------------------------
# Where confirmed orders are POSTed as JSON. Until Medusa.js is in place this
# is the only durable store — on Vercel the filesystem is ephemeral, so without
# it orders are logged to the server console and nothing else.
# A Google Sheets / Zapier / Make webhook is a reasonable Phase 1 stopgap.
ORDER_WEBHOOK_URL=

# --- Meta Pixel + Conversions API -------------------------------------------
# Pixel ID is also needed client-side for the browser Pixel snippet.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Set while testing so events land in Events Manager > Test Events only.
META_TEST_EVENT_CODE=

# --- Public (exposed to the browser) ----------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
